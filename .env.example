CDSS_APP_NAME=Respiratory CDSS API
CDSS_APP_VERSION=0.1.0
CDSS_ENVIRONMENT=development
CDSS_DEBUG=true
CDSS_DOCS_URL=/docs
CDSS_REDOC_URL=/redoc
CDSS_OPENAPI_URL=/openapi.json

CDSS_DATABASE_URL=sqlite:///./cdss.db
# PostgreSQL example:
# CDSS_DATABASE_URL=postgresql+psycopg://cdss:cdss@localhost:5432/cdss
# Neon example:
# CDSS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
CDSS_AUTO_CREATE_TABLES=true

CDSS_JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
CDSS_JWT_ALGORITHM=HS256
CDSS_ACCESS_TOKEN_EXPIRE_MINUTES=30
CDSS_REFRESH_TOKEN_EXPIRE_DAYS=7

CDSS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

CDSS_ML_MODEL_PATH=./ml_models/respiratory_nb_model.json
